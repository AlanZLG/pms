# ===== 服务配置 =====
# 后端服务端口
PORT=3001

# JWT 签名密钥(生产环境务必修改为强随机字符串)
JWT_SECRET=pm-dev-secret-change-me

# ===== 邮件通知 (SMTP) =====
# 任务完成时给负责人发送邮件通知
# 未配置以下变量时,邮件功能自动跳过,不影响系统运行
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
# 发件人显示(可选,默认使用 SMTP_USER)
SMTP_FROM=Atlas <your-email@example.com>

# 常见邮箱 SMTP 参考:
# Gmail:    smtp.gmail.com:587  (需使用应用专用密码)
# QQ 邮箱:  smtp.qq.com:465     (需开启 SMTP 并使用授权码)
# 163 邮箱: smtp.163.com:465    (需开启 SMTP 并使用授权码)
# Outlook:  smtp.office365.com:587

# ===== 飞书集成 (Feishu / Lark) =====
# 在飞书开放平台创建"自建应用",获取 App ID 和 App Secret
# https://open.feishu.cn/app
# 需开通权限: 获取用户基本信息 (contact:user.base:readonly) + 发送消息 (im:message)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OAuth 回调地址,需与飞书后台配置一致
FEISHU_REDIRECT_URI=http://localhost:5173/settings?feishu_callback=1
# 飞书消息模板: title 和 body 会拼接到卡片消息中
FEISHU_MSG_TITLE=Atlas 项目管理系统通知

# ===== AI 经验分析（运维台账） =====
# 任意 OpenAI 兼容协议的模型服务(chat completions)。
# 未配置以下变量时,台账「AI 分析」入口自动隐藏,不影响系统其他功能
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=your-api-key
# LLM_CHAT_MODEL=doubao-seed-1-6
# 响应超时(毫秒,可选,默认 60000)
# LLM_TIMEOUT_MS=60000

# ===== AI 语义召回（可选,运维台账经验召回的 embedding 重排） =====
# 配置后召回结果会按向量相似度与关键词分融合重排,语义相近(不同措辞)的历史案例更容易被召回。
# LLM_EMBED_BASE_URL/LLM_EMBED_API_KEY 未配置时回落到上面的 LLM_BASE_URL/LLM_API_KEY
# LLM_EMBED_MODEL 不配置则关闭该功能,退回纯关键词排序
# LLM_EMBED_BASE_URL=
# LLM_EMBED_API_KEY=
# LLM_EMBED_MODEL=doubao-embedding
