# ===== 服务配置 =====
# 后端服务端口
PORT=3001

# JWT 签名密钥(生产环境务必修改为强随机字符串)
JWT_SECRET=pm-dev-secret-change-me

# ===== 邮件通知 (SMTP) =====
# 任务完成时给负责人发送邮件通知
# 未配置以下变量时,邮件功能自动跳过,不影响系统运行
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
# 发件人显示(可选,默认使用 SMTP_USER)
SMTP_FROM=Atlas <your-email@example.com>

# 常见邮箱 SMTP 参考:
# Gmail:    smtp.gmail.com:587  (需使用应用专用密码)
# QQ 邮箱:  smtp.qq.com:465     (需开启 SMTP 并使用授权码)
# 163 邮箱: smtp.163.com:465    (需开启 SMTP 并使用授权码)
# Outlook:  smtp.office365.com:587
